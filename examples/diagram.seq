component "browser" as b [color=salmon,];
component "server" as s;
database "database" as d;

overlay component "backend" as be [color=lightblue] : s d;

b -x s [color=#ff0000, ] : GET /path "lol"\n2nd line {}
{
    s -> d [color=blue] : SELECT
    note [left, shape=rectangle] "text on the left"
    ... an eternity later
    s ->o d [color=blue] : SELECT
    {
        note [left] "text on the left"
        note [right, shape=hexagonal] "text on the right"
        d <- d [color=green] : ok
        ...
        note [leftof=d, color=olive] "text"
        return [color=orange] : ok
    }
    == divider\nfails
    ==
    note "across"
    return [color=#ff0000, ] : data
}
